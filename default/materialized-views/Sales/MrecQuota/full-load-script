df1 = read("Sales.MrecQuotaStage")
df = df1.toPandas()


np_names = df['Sales_Rep_ID'].value_counts().index
Brandname = 'MREC'
df2 = pd.DataFrame()



for i in range(len(np_names)):
    new_df = df[df['Sales_Rep_ID'].isin([np_names[i]])]
    np_df = new_df.T[5:]
    np_df.columns = new_df.T.iloc[1,:].values
    np_df['Month'] = np_df.index
    
    np_df.columns = ['Quota','Month']
    np_df['SalesRepID'] = [np_names[i] for j in np_df.index]
    np_df['BrandCode'] = [Brandname for j in np_df.index]
    np_df = np_df.reset_index(drop = True)
    np_df = np_df[[ 'BrandCode', 'SalesRepID','Month', 'Quota']]
    df2 = df2.append(np_df, ignore_index= 'True')



